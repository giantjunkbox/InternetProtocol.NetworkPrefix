<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Bitvantage.InternetProtocol</RootNamespace>
		<Title>IPNetwork Extensions: CIDR and subnet math for System.Net.IPNetwork</Title>
		<PackageProjectUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefix</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ipnetwork;cidr;subnet;subnetting;supernet;supernetting;netmask;subnet-mask;wildcard-mask;subnet-calculator;cidr-calculator;ip-range;range-to-cidr;ipam;ip-address;ipaddress;reverse-dns;ipv4;ipv6;network;networking;extension-members</PackageTags>
		<VersionPrefix>3.0.0</VersionPrefix>
		<FileVersion>3.0.0</FileVersion>
		<AssemblyVersion>3.0.0</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
		<Description>CIDR, subnet and supernet math for System.Net.IPNetwork and IPAddress. Adds network and wildcard masks, host ranges, subnet and supernet tests, splitting, summarization, exclusion, IP range to CIDR conversion, free subnet search, sorting, address arithmetic, IANA address classification, strict parsing, reverse DNS names and JSON serialization as C# 14 extension members.</Description>
		<RepositoryUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefix.git</RepositoryUrl>
		<Copyright>Copyright © Michael Crino 2024</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<!-- a library has no excuse for warnings, and this keeps every public member documented -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- turns on the trimming and native AOT analyzers, and tells consumers the library is safe to trim and compile ahead of time -->
		<IsAotCompatible>true</IsAotCompatible>

		<!-- Source Link, which the SDK includes, lets a debugger fetch the exact source of a build from the repository -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<!-- normalizes the paths embedded in a CI build, so the same commit always produces the same package -->
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="" />
		<None Include="../icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>