<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Bitvantage.InternetProtocol</RootNamespace>
		<Title>IPNetwork Extensions: CIDR and subnet math for System.Net.IPNetwork</Title>
		<PackageProjectUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefix</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ipnetwork;cidr;subnet;subnetting;supernet;supernetting;netmask;subnet-mask;wildcard-mask;subnet-calculator;cidr-calculator;ip-address;ipaddress;ipv4;ipv6;network;networking;extension-members</PackageTags>
		<VersionPrefix>3.0.0</VersionPrefix>
		<FileVersion>3.0.0</FileVersion>
		<AssemblyVersion>3.0.0</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
		<Description>CIDR, subnet and supernet math for System.Net.IPNetwork. Adds network masks, host ranges, subnet and supernet tests, splitting, summarization, exclusion, sorting, address classification, strict parsing and JSON serialization as C# 14 extension members.</Description>
		<RepositoryUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefix.git</RepositoryUrl>
		<Copyright>Copyright © Michael Crino 2024</Copyright>

	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="" />
		<None Include="../icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>